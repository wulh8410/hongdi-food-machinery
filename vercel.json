{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hongdi-food-machinery.vercel.app"
        }
      ],
      "destination": "https://hd.hong1234.com/:path*",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/zh/privacy/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/zh/terms/",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/zh/",
      "permanent": false
    }
  ]
}
